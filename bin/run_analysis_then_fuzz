#!/bin/bash

PLUGIN_SLUG=$1

if [[ $PLUGIN_SLUG == "" ]]; then
  echo "Please input a plugin slug to "
  exit 0
fi

set -e

cd "$(dirname "$0")/.."

COMPOSER_WHICH=1

# Check if composer is installed
if [[ $(which composer | grep -o composer) == "composer" ]]; then
  COMPOSER_WHICH=1
else
  COMPOSER_WHICH=0
fi

if [[ $COMPOSER_WHICH -ne 0 ]]; then
  COMPOSER_VERSION=$(composer --version | cut -d " " -f3)
  echo "Composer found."
  echo "Installed version $COMPOSER_VERSION"
else
  echo "Composer not found"
  echo "Please make sure composer is installed and available via your PATH variable"
  exit 0
  # automatic installation of composer, maybe add later

  # echo "Shall we install composer? (y/n)"
  # while true; do
  #  read -s -n 1 key
  #  case $key in y|Y)
  #    echo "Installing..."
  #    ./psalm/build_composer.sh
  #    break
  #    ;;
  #  n|N)
  #    echo "Not installing!"
  #    exit 0
  #    ;;
  #  esac
  # done
fi

# Install composer packages
echo "Installing composer packages..."
cd ./psalm
composer update
composer install






